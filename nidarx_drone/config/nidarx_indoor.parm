# ============================================================
# NidarX Indoor Quadcopter — ArduCopter SITL Parameters
# Gazebo IMU, horizontal lidar odometry and downward lidar
# NO GPS — indoor flight
# ============================================================

# ── Frame ──
FRAME_CLASS     1       # Quad
FRAME_TYPE      1       # X-frame

# ── Disable GPS (indoor flight) ──
GPS1_TYPE        0       # No GPS
GPS2_TYPE        0
SIM_GPS1_ENABLE  0       # Disable simulated GPS
SIM_GPS2_ENABLE  0

# ── GPS-free EKF3 navigation over the SITL companion MAVLink port ──
EK3_ENABLE      1
EK3_SRC1_POSXY  6       # ExternalNav from horizontal scan matching
EK3_SRC1_VELXY  0       # No independently measured velocity
EK3_SRC1_POSZ   2       # Downward rangefinder over the flat floor
EK3_SRC1_VELZ   0
EK3_SRC1_YAW    6       # Scan yaw is aligned to Gazebo north at spawn
AHRS_EKF_TYPE   3       # Use EKF3
EK2_ENABLE      0       # Disable EKF2
VISO_TYPE       1       # MAVLink VISION_POSITION_ESTIMATE
VISO_POS_M_NSE  0.10    # Planar scan position measurement noise in metres
SERIAL1_PROTOCOL 2      # MAVLink2 on the second SITL TCP port

# The indoor world uses the default SITL launch site's geodetic origin.
AHRS_OPTIONS    16      # Use recorded origin for GPS-free navigation
AHRS_ORIGIN_LAT -35.363262
AHRS_ORIGIN_LON 149.165237
AHRS_ORIGIN_ALT 584

RNGFND1_TYPE    10      # MAVLink DISTANCE_SENSOR
RNGFND1_ORIENT  25      # Downward (pitch 270)
RNGFND1_MIN     0.05
RNGFND1_MAX     10.0
RNGFND1_POS_Z   0.045   # Positive down in ArduPilot body FRD
RNGFND1_GNDCLR  0.145   # Distance from emitter to floor on the landing legs
EK3_RNG_M_NSE   0.10    # Range measurement noise in metres
WP_RFND_USE     0       # Guided takeoff target is relative to home
WP_SPD_UP       0.50    # Indoor Guided climb speed in m/s
WP_SPD          0.70    # Travel about 13 cm per horizontal scan
WP_ACC          0.50    # Near-level acceleration for mapping in m/s²
WP_YAW_BEHAVIOR 0       # Hold pilot heading through indoor Guided moves
PLND_ENABLED    0       # The indoor model lands on the floor without an IR beacon

# ── Arming checks — SITL/no-GPS indoor ──
ARMING_CHECK    0       # Disable pre-arm checks for indoor SITL
ARMING_SKIPCHK  0

# ── Gyro startup calibration ──
INS_GYR_CAL     0       # SITL gyros are calibrated internally
INS_GYROFFS_X   0
INS_GYROFFS_Y   0
INS_GYROFFS_Z   0

# ── SITL IMU instances ──
# The simulator exposes one IMU; disable extra instances to avoid
# false "accelerometers inconsistent" checks.
INS_ENABLE_MASK 1
INS_USE         1
INS_USE2        0
INS_USE3        0
INS_ACC_ID      0
INS_ACC2_ID     0
INS_ACC3_ID     0
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X  0
INS_ACC2OFFS_Y  0
INS_ACC2OFFS_Z  0
INS_ACC2SCAL_X  1
INS_ACC2SCAL_Y  1
INS_ACC2SCAL_Z  1
INS_ACC3OFFS_X  0
INS_ACC3OFFS_Y  0
INS_ACC3OFFS_Z  0
INS_ACC3SCAL_X  1
INS_ACC3SCAL_Y  1
INS_ACC3SCAL_Z  1

# ── Disarmed motor state ──
DISARM_DELAY    0
MOT_SAFE_DISARM 0
MOT_SPIN_ARM    0
MOT_SPIN_MIN    0
MOT_THST_HOVER  0.326   # Measured steady hover throttle for this Gazebo airframe

# ── Barometer (Pixhawk 2.4.8 onboard MS5611) ──
# Default SITL values are fine; baro is always enabled

# ── Compass (Pixhawk 2.4.8 onboard HMC5883L) ──
COMPASS_USE     1
COMPASS_USE2    0
COMPASS_USE3    0

# ── Flight modes ──
FLTMODE1        0       # Stabilize
FLTMODE4        2       # AltHold (good for indoor)
FLTMODE6        5       # Loiter using lidar position hold

# ── Safety ──
FS_THR_ENABLE   0       # Disable throttle failsafe for SITL
BRD_SAFETY_DEFLT 0      # No safety switch required
