<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Gazebo Materials ==================== -->
  <gazebo reference="body_link">
    <material>Gazebo/DarkGrey</material>
    <mu1>100</mu1>
    <mu2>100</mu2>
  </gazebo>

  <gazebo reference="front_marker">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="arm_0">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="arm_1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="arm_2">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="arm_3">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ==================== Rotor Lift-Drag Plugin ==================== -->
  <xacro:macro name="rotor_lift_drag" params="id direction opposite">
    <gazebo>
      <plugin name="rotor_${id}_blade_1" filename="libLiftDragPlugin.so">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
        <cla>4.25</cla>
        <cda>0.10</cda>
        <cma>0.0</cma>
        <cla_stall>-0.025</cla_stall>
        <cda_stall>0.0</cda_stall>
        <cma_stall>0.0</cma_stall>
        <area>0.002</area>
        <air_density>1.2041</air_density>
        <cp>0.0762 0 0</cp>
        <forward>0 ${direction} 0</forward>
        <upward>0 0 1</upward>
        <link_name>nidarx_drone::prop_${id}</link_name>
      </plugin>
      <plugin name="rotor_${id}_blade_2" filename="libLiftDragPlugin.so">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
        <cla>4.25</cla>
        <cda>0.10</cda>
        <cma>0.0</cma>
        <cla_stall>-0.025</cla_stall>
        <cda_stall>0.0</cda_stall>
        <cma_stall>0.0</cma_stall>
        <area>0.002</area>
        <air_density>1.2041</air_density>
        <cp>-0.0762 0 0</cp>
        <forward>0 ${opposite} 0</forward>
        <upward>0 0 1</upward>
        <link_name>nidarx_drone::prop_${id}</link_name>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:rotor_lift_drag id="0" direction="1" opposite="-1"/>
  <xacro:rotor_lift_drag id="1" direction="1" opposite="-1"/>
  <xacro:rotor_lift_drag id="2" direction="-1" opposite="1"/>
  <xacro:rotor_lift_drag id="3" direction="-1" opposite="1"/>

  <!-- ==================== IMU Sensor (Pixhawk 2.4.8 onboard IMU) ==================== -->
  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <pose>0 0 0 3.141593 0 0</pose>
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_sensor_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/nidarx_drone/imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- SLAMTEC RPLIDAR A1M8: 360-degree scan, 12 m maximum range. -->
  <gazebo reference="rplidar_link">
    <sensor name="rplidar_sensor" type="ray">
      <pose>0 0 0.025 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>5.5</update_rate>
      <!-- Show the ray fan in the Gazebo client. -->
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="rplidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/nidarx_drone/rplidar/data</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>rplidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- PONO TSDI0: downward-facing single-point ToF LiDAR, 0.05-10 m at 50 Hz. -->
  <gazebo reference="downward_lidar_link">
    <sensor name="downward_lidar_sensor" type="ray">
      <!-- A +X ray rotated about Y points down along -Z. -->
      <pose>0 0 0 0 1.5708 0</pose>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1.0</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.05</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="downward_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/nidarx_drone/downward_lidar/data</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>downward_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Ground-truth model odometry for RViz and downstream consumers. -->
  <gazebo>
    <plugin name="odometry_plugin" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=/nidarx_drone/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>30</update_rate>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- ==================== ArduPilot Plugin ==================== -->
  <gazebo>
    <plugin name="arducopter_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      <imuName>nidarx_drone::base_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <control channel="0">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_0_joint</jointName>
        <multiplier>838</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
      <control channel="1">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_1_joint</jointName>
        <multiplier>838</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
      <control channel="2">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_2_joint</jointName>
        <multiplier>-838</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
      <control channel="3">
        <type>VELOCITY</type>
        <offset>0</offset>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_3_joint</jointName>
        <multiplier>-838</multiplier>
        <rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim>
      </control>
    </plugin>
  </gazebo>

</robot>
